* text=auto
*.py text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.jpg -text

# A signed manifest is hashed as exact bytes; never normalize its line endings.
proofs/*-source-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
